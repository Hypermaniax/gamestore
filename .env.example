# Template environment — copy ke .env lalu ganti semua nilai GANTI.
# Nilai rahasia TIDAK pernah di-commit (PLAN §13).
# Produksi: secret memakai file read-only chmod 600 atau secret manager.

# ── Database ──
# Satu koneksi untuk aplikasi, migration, seed, dan test.
DATABASE_URL=postgresql://dev:GANTI@127.0.0.1:5432/gamestore_dev?schema=public

# ── Secret (file chmod 600 di prod) ──
JWT_SECRET_FILE=/etc/gamestore/jwt.secret
AES_KEYRING_FILE=/etc/gamestore/aes-keyring.json
# Opsional: pilih key aktif; kosong = key pertama di keyring.
AES_KEY_VERSION=
TOTP_EMERGENCY_TOKEN_FILE=/etc/gamestore/totp-emergency.token
# Token untuk sesi CLI darurat (ambil dari file di atas; jangan simpan di .env produksi)
TOTP_DARURAT_TOKEN=

# ── Xendit (sandbox → live cukup ganti nilai) ──
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co

# ── Superadmin awal (seeder; hanya jalan bila belum ada ADMIN) ──
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Email (SMTP; dev: Mailpit) ──
# Mailpit: MAIL_USER/MAIL_PASSWORD kosong, MAIL_PORT=1025.
# Produksi: port 587 (STARTTLS) atau 465 (SSL), isi user/password.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@nexaplay.local

# ── Aplikasi ──
APP_BASE_URL=http://localhost:3000
# Produksi wajib https://
# Jumlah trusted proxy di depan app (0 = abaikan X-Forwarded-For).
# Satu reverse proxy (Nginx/Caddy) → 1; Cloudflare + proxy → 2 (hitung dan uji).
TRUST_PROXY_HOPS=0
# Inbox operasional (event admin: reset TOTP, webhook gagal, dst)
ADMIN_EMAIL=

# ── Aturan bisnis ──
GARANSI_HARI=3
GARANSI_MAKS_TANPA_REVEAL_HARI=2
EXPIRY_MENIT=30
MAKS_PENDING_PER_USER=2
REFRESH_TOLERANSI_DETIK=20
IDEMPOTENCY_PROCESSING_TTL_MENIT=5
# false di dev; true di produksi (startup menolak nilai lain)
TOTP_WAJIB_ADMIN=false

# ── Upload foto ──
# Pisahkan dengan koma bila lebih dari satu domain.
FOTO_DOMAIN_WHITELIST=images.unsplash.com

# ── Retensi data (hari, kecuali audit PII = bulan) ──
RETENSI_WEBHOOK_PAYLOAD_HARI=90
RETENSI_IDEMPOTENCY_SNAPSHOT_HARI=30
RETENSI_TOKEN_HARI=30
RETENSI_AUDIT_PII_BULAN=24

# ── Test seed (dev/test saja) ──
ALLOW_TEST_SEED=0
TEST_SEED_PASSWORD=Test1234!
# Tes integrasi akan DROP SCHEMA public pada DATABASE_URL. Aktifkan hanya jika data boleh hilang.
ALLOW_DESTRUCTIVE_TESTS=0

# ── CLI-only (jangan diisi di .env aplikasi) ──
# PDP_KONFIRMASI=
