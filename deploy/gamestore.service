[Unit]
Description=NEXAPLAY gamestore
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=gamestore
Group=gamestore
WorkingDirectory=/opt/gamestore
EnvironmentFile=/etc/gamestore/gamestore.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gamestore/.next/cache /var/log/gamestore
UMask=0077
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
